use MatesOfMate\Benchmark\Command\BenchmarkRunCommand;
use MatesOfMate\Benchmark\Scenario\ScenarioLoader;
use MatesOfMate\Benchmark\Scenario\ScenarioRepository;
use MatesOfMate\Benchmark\Scenario\ScenarioValidator;
use Symfony\Component\Console\Application;

require __DIR__.'/../vendor/autoload.php';

$projectRoot = \dirname(__DIR__);
$loader = new ScenarioLoader();
$validator = new ScenarioValidator($projectRoot.'/schema/scenario.schema.json');
$repository = new ScenarioRepository($projectRoot.'/scenarios', $loader, $validator);

$application = new Application('Symfony AI Mate Benchmark', '0.1.0');
$application->addCommand(new BenchmarkRunCommand($repository));
$application->setDefaultCommand('list');
$application->run();
