includes:
    - vendor/phpstan/phpstan-phpunit/extension.neon

parameters:
    # Run at maximum strictness level
    level: 8

    # Paths to analyze
    paths:
        - src
        - tests

    excludePaths:
        # Scenario fixture projects are benchmark inputs, not code under test.
        - tests/Fixtures/*

    # Don't treat PHPDoc types as certain to catch type issues
    treatPhpDocTypesAsCertain: false

    # Add ignored errors here if needed
    ignoreErrors:
